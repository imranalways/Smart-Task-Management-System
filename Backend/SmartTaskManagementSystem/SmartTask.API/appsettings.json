{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost;Database=SmartTaskDb;Integrated Security=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "THIS_IS_A_VERY_LONG_SECRET_KEY_MINIMUM_64_CHARACTERS_FOR_PRODUCTION",
    "Issuer": "SmartTaskAPI",
    "Audience": "SmartTaskClient",
    "ExpiryMinutes": 15
  },
  "Ai": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "Model": "gemini-3.5-flash-lite",
    "Temperature": 0.3,
    "MaxTokens": 1000,
    "TimeoutSeconds": 30
  },
  "DefaultAdmin": {
    "FirstName": "System",
    "LastName": "Administrator"
  }
}
